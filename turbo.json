{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "//#api:ready": {
      "cache": false,
      "passThroughEnv": ["API_URL"]
    },
    "web#dev": {
      "with": ["api#dev"],
      "dependsOn": ["^build", "//#api:ready"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["API_URL"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
