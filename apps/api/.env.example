# API tự load/validate .env; DATABASE_URL và WEB_URL bắt buộc.
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# PostgreSQL: pgvector/pgvector:pg16. Điền URL của database MarketOS riêng.
# Chỉ cho Docker Compose dev cục bộ. Production dùng credentials riêng.
DATABASE_URL=postgresql://marketos:marketos_dev@localhost:5433/marketos?schema=public

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# OpenAI: chỉ dùng ở backend; điền model OpenAI hỗ trợ structured output.
OPENAI_API_KEY=
AI_MODEL=
IMAGE_MODEL=gpt-image-2.5-sunburst

# Phase 11 image storage: ImageKit private API key stays on the backend.
# Find both values in ImageKit Dashboard > Developer options > API keys / URL endpoint.
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
REDIS_URL=redis://localhost:6380

# Phase 10 integrations: register each OAuth callback at <OAUTH_CALLBACK_BASE>/api/oauth/<provider>/callback.
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
OAUTH_CALLBACK_BASE=
# Base64 of exactly 32 random bytes; never commit a populated value.
TOKEN_ENCRYPTION_KEY=
