# API tự load/validate .env; DATABASE_URL và WEB_URL bắt buộc.
NODE_ENV=development
PORT=3001
WEB_URL=http://localhost:3000

# PostgreSQL: pgvector/pgvector:pg16. Điền URL của database MarketOS riêng.
# Chỉ cho Docker Compose dev cục bộ. Production dùng credentials riêng.
DATABASE_URL=postgresql://marketos:marketos_dev@localhost:5433/marketos?schema=public

# Clerk
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_WEBHOOK_SECRET=

# OpenAI: chỉ dùng ở backend; điền model OpenAI hỗ trợ structured output.
OPENAI_API_KEY=
AI_MODEL=
REDIS_URL=redis://localhost:6380
