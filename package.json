{
  "name": "marketer-os",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/shared"
  ],
  "packageManager": "npm@12.1.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "api:ready": "node scripts/wait-for-api.mjs",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test"
  },
  "devDependencies": {
    "node": "24.21.0",
    "prettier": "3.9.9",
    "turbo": "2.11.5",
    "eslint": "9.39.5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@prisma/engines@7.10.0": true,
    "node@24.21.0": true,
    "prisma@7.10.0": true,
    "unrs-resolver@1.12.2": true,
    "@scarf/scarf": false
  }
}
